# Copy this file to `.env` (in the organizer folder) and fill in what you want.
# Everything is optional. Each line you fill in switches on one more ability.
# Never commit your real .env file: it's already in .gitignore.

# --- The brain: lets you talk in plain English (get a key at console.anthropic.com) ---
ANTHROPIC_API_KEY=
# ORGANIZER_MODEL=claude-sonnet-5-5
# Stop calling Claude after this many tokens per day (a cost safety net)
# ORGANIZER_DAILY_TOKEN_LIMIT=2000000

# --- About you ---
ORGANIZER_USER_NAME=
# e.g. America/New_York, Europe/London, Asia/Kolkata (blank = this computer's timezone)
ORGANIZER_TIMEZONE=
# When the morning briefing is sent (24-hour clock)
ORGANIZER_BRIEFING_TIME=08:00

# --- Email (Gmail: use an app password from myaccount.google.com/apppasswords) ---
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
# To also send email (always asks you first). For Gmail: smtp.gmail.com
SMTP_HOST=
# SMTP_PORT=587

# --- Calendar: your calendar's *secret iCal address*, comma-separate several ---
# Google Calendar: Settings > (your calendar) > Integrate calendar > Secret address in iCal format
CALENDAR_ICS_URLS=

# --- Your documents (then run: python -m organizer index) ---
ORGANIZER_DOCUMENTS_DIR=

# --- Telegram bot: @BotFather gives the token, @userinfobot tells you your user id ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=

# --- Web app ---
# ORGANIZER_WEB_PORT=8765
# To open it to other devices: set HOST to 0.0.0.0 AND a long random token
# ORGANIZER_WEB_HOST=127.0.0.1
# ORGANIZER_WEB_TOKEN=

# --- Better web search (optional, free tier at brave.com/search/api) ---
# BRAVE_API_KEY=
