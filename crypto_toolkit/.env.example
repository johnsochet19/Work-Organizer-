# Copy to .env and fill in what you use. Everything is optional except where noted.
COINGECKO_API_KEY=        # free Demo key: coingecko.com/en/developers/dashboard
CMC_API_KEY=              # free Basic key: pro.coinmarketcap.com/signup (needed for CoinMarketCap class)

# Alert delivery (pick any)
NTFY_TOPIC=               # install the free ntfy app, subscribe to a long random topic name
WEBHOOK_URL=              # Slack/Discord incoming webhook
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=                # Gmail: use an App Password
ALERT_EMAIL_TO=

# Live trading — leave OFF until you've backtested and paper traded
LIVE_TRADING=no
MAX_ORDER_USD=50
COINBASE_API_KEY=         # create trade-only keys, NEVER enable withdrawals
COINBASE_API_SECRET=
